---
title: 虚拟文件系统 (VFS) 架构
---
graph TB
    subgraph VFS["fileKernel 单例（utils/file/fileKernel.js，export default new fileKernel()）"]
        direction TB
        InodeMap["inodeMap: Map id→Inode<br/>内存镜像"]
        TreeMap["treeMap: Map parentId→Set&lt;childId&gt;<br/>目录树索引"]
        Ready["ready: boolean"]
        Events["events: EventTarget<br/>change 事件"]
        Boot["boot()<br/>driver.mount() → loadAllInodes() → 重建索引"]
    end

    subgraph InodeStruct["Inode 数据结构（扁平，无 meta 包装、无 symlink）"]
        direction TB
        ID["id: crypto.randomUUID()<br/>预设资源用固定 id"]
        ParentId["parentId: String<br/>根为 'root'"]
        Name["name: String"]
        Type["type: FileType<br/>FILE=1 | DIRECTORY=2"]
        Content["content: any<br/>直接存 Inode"]
        Size["size: content.length"]
        Times["ctime / mtime: Date.now()"]
    end

    subgraph APIOperations["fileKernel 公开 API（一律按 id/parentId，不接路径）"]
        direction TB
        Readdir["readdir(id)<br/>同步返回，目录优先 + name.localeCompare"]
        Mkdir["mkdir(parentId, name)"]
        WriteFile["writeFile(parentId, name, content)"]
        ReadFile["readFile(id)"]
        UpdateContent["updateContent(id, content)<br/>目录抛'非文件'，不 emitChange"]
        Unlink["unlink(id)<br/>递归收集子树后整批删除"]
        Rename["rename(id, newName)"]
        Move["move(id, targetParentId)<br/>含祖先环检测"]
        GetPath["getPath(id)<br/>返回 Inode 数组（面包屑）"]
        Watch["watch(callback) → 返回取消函数<br/>detail: {dirId}"]
    end

    subgraph Private["私有内部方法"]
        direction TB
        CreateEntry["#createEntry(parentId,name,type,content)<br/>校验父目录 + 同名查重"]
        SyncMemory["#syncMemory(inode)"]
        RemoveMemory["#removeFromMemory(id)"]
        FormatDisk["#formatDisk() 仅建 root 目录"]
        EmitChange["#emitChange(dirId)"]
    end

    subgraph IndexedDB["fileIndexDb 持久化层（utils/file/fileIndexDb.js）"]
        direction TB
        Mount["mount()<br/>已连接则直接返回 true"]
        WriteInode["writeInode(inode) → resolve(id)"]
        ReadInode["readInode(id)"]
        UnlinkInode["unlinkInode(id)"]
        LoadAll["loadAllInodes()"]
        Count["count()"]
        Exists["exists(parentId, name)<br/>参数顺序是 (parentId, name)"]
        Tx["#tx(mode) 未挂载即抛'未挂载!'"]
    end

    subgraph Preset["mount 成功后依次预设挂载"]
        direction TB
        InitRes["#initSystemResources()<br/>preSystemFileData：fetch(public) → Blob → dataURL"]
        InitCfg["#initSystemConfigFiles()<br/>preSystemConfigFiles：直接写默认内容"]
        InitSample["#initSampleAppFiles()<br/>SAMPLE_APP_DIR + 逐级补建目录"]
    end

    subgraph IndexedDBStore["IndexedDB 存储结构（DB_VFILE，config.js:125-134）"]
        direction TB
        DBName["DB 名: 'SUKIN_OS_VFS'<br/>全局共享，不按用户分库"]
        ObjectStore["ObjectStore: 'files'"]
        KeyPath["keyPath: 'id'，VERSION: 2"]
        IdxParent["索引 'parentId' → keyPath 'parentId'"]
        IdxComposite["索引 'parent_name_idx'<br/>→ keyPath ['parentId','name']"]
    end

    VFS --> InodeStruct
    VFS --> APIOperations
    Boot --> LoadAll
    Boot -->|"inodes 为空或缺 root"| FormatDisk
    APIOperations --> Private
    CreateEntry --> WriteInode
    Private --> SyncMemory
    Private --> EmitChange
    APIOperations --> IndexedDB
    IndexedDB --> IndexedDBStore
    Mount --> Preset
    Preset --> WriteInode
