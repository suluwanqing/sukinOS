---
title: Redux Store 状态树
---
graph TB
    subgraph Store["Redux Store"]
        direction TB
        Config["configureStore()<br/>sukinos 切片"]
        SukinosSlice["sukinosSlice<br/>createSlice"]
    end

    subgraph State["initialState 状态域"]
        direction TB
        UserInfo["userInfo: {}<br/>用户信息（登录后填充）"]
        Theme["theme: ''<br/>主题标识"]
        UI["ui: {}<br/>UI 通用状态"]
        Assistant["assistant<br/>verificationCodes: {}<br/>验证码状态（按 type 索引）"]
        Setting["setting<br/>isDisplay: true"]
        AppStore["appStore"]
        FileSystemConfig["fileSystemConfig<br/>isPrivate: true"]
        RoutePermissions["routePermissions<br/>config / loaded / lastUpdated"]
    end

    subgraph AppStoreDetail["appStore 详情"]
        direction TB
        StorePath["storePath（9 个 URL）<br/>baseUrl / listUrl / uploadUrl<br/>checkUpdatesUrl / searchUrl<br/>myUploadUrl / deleteUrl<br/>withPermissionUrl / authorizedUrl"]
        GenerateApp["generateApp<br/>singleIframe / truthAllApp<br/>useVirtualWorker / maxWindows<br/>maxWorkers / workerLRU"]
    end

    subgraph Reducers["Reducers（10 个）"]
        direction TB
        R1["startVerificationCountdown"]
        R2["resetVerification"]
        R3["updateSeting"]
        R4["setUserInfo"]
        R5["setStorePath / resetStorePath"]
        R6["setFileSystemConfig"]
        R7["setRoutePermissions / clearRoutePermissions"]
        R8["setGenerateApp"]
    end

    subgraph Selectors["Selectors（9 个）"]
        direction TB
        S1["selectSukinOs"]
        S2["selectorSetting"]
        S3["selectorUserInfo"]
        S4["selectorStoreSettingStorePath"]
        S5["selectGenerateApp"]
        S6["selectFileSystemConfig"]
        S7["selectorRoutePermissions / selectorRoutePermissionsLoaded"]
        S8["selectVerificationData(type)"]
    end

    Store --> SukinosSlice
    SukinosSlice --> UserInfo
    SukinosSlice --> Theme
    SukinosSlice --> UI
    SukinosSlice --> Assistant
    SukinosSlice --> Setting
    SukinosSlice --> AppStore
    SukinosSlice --> FileSystemConfig
    SukinosSlice --> RoutePermissions
    AppStore --> StorePath
    AppStore --> GenerateApp
    SukinosSlice --> Reducers
    SukinosSlice --> Selectors